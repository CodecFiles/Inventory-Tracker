@@ -165,6 +165,15 @@ function Connection(options, queues = {}, { onopen = noop, onend = noop, onclose
     if (q.cancelled)
       return
 
+    // MRD patch: the connection closed (e.g. mid-transaction) and the socket is gone. Fail this
+    // query now instead of writing to a null socket (uncaught TypeError, then the pool hangs).
+    // Return true so callers do not move this connection to the "full" queue: it must stay in
+    // "closed", where the pool reconnects it for the next query.
+    if (!socket) {
+      queryError(q, Errors.connection('CONNECTION_CLOSED', options))
+      return true
+    }
+
     try {
       q.state = backend
       query
